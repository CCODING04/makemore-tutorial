{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Hybrid RAG 数据流",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "p18_hybrid_rag.html",
    "viewBox": [
      1080,
      440
    ],
    "legend": {
      "mode": "auto",
      "entries": {
        "emphasis": {
          "label": "在线查询主路（双 top-10 汇合）"
        },
        "dashed": {
          "label": "离线词表统计路径"
        },
        "database": {
          "label": "向量索引 / 语料"
        }
      }
    }
  },
  "stages": [
    {
      "label": "语料"
    },
    {
      "label": "索引 + 查询"
    },
    {
      "label": "双路召回"
    },
    {
      "label": "融合与重排"
    },
    {
      "label": "生成"
    }
  ],
  "nodes": [
    {
      "id": "corpus",
      "type": "database",
      "label": "语料 part18_corpus/",
      "sublabel": "8 篇 md · ~86k 字符",
      "stage": 0,
      "row": 0,
      "width": 150,
      "height": 58
    },
    {
      "id": "index",
      "type": "backend",
      "label": "Qwen3-Embedding-0.6B",
      "sublabel": "recursive_chunk 512/64 → 238 chunks",
      "tag": "L2 归一 · (238, 1024)",
      "stage": 1,
      "row": 0,
      "width": 170,
      "height": 58
    },
    {
      "id": "dense",
      "type": "backend",
      "label": "dense 检索",
      "sublabel": "chunk_mat @ q_vec → top-10",
      "tag": "Instruct 前缀",
      "stage": 2,
      "row": 0,
      "width": 170,
      "height": 58
    },
    {
      "id": "bm25",
      "type": "backend",
      "label": "BM25 检索",
      "sublabel": "打分 238 个 chunk → top-10",
      "stage": 2,
      "row": 1,
      "width": 170,
      "height": 58
    },
    {
      "id": "rrf",
      "type": "backend",
      "label": "RRF 融合",
      "sublabel": "只融合名次，k=60",
      "tag": "hybrid_top × 10",
      "stage": 3,
      "row": 0,
      "width": 160,
      "height": 58
    },
    {
      "id": "rerank",
      "type": "backend",
      "label": "bge-reranker-v2-m3 重排",
      "sublabel": "(query, chunk) 成对打分",
      "tag": "rerank_top × 5",
      "stage": 3,
      "row": 1,
      "width": 180,
      "height": 58
    },
    {
      "id": "gen",
      "type": "frontend",
      "label": "Qwen2.5-0.5B-Instruct 生成",
      "sublabel": "证据编号 [1][2][3] → answer",
      "tag": "top-3 证据",
      "stage": 4,
      "row": 0,
      "width": 180,
      "height": 58
    },
    {
      "id": "query",
      "type": "frontend",
      "label": "user query",
      "sublabel": "Instruct 前缀 → q_vec (1, 1024)",
      "stage": 1,
      "row": 1,
      "width": 150,
      "height": 58
    }
  ],
  "flows": [
    {
      "id": "corpus-index",
      "from": "corpus",
      "to": "index",
      "label": "装箱",
      "route": "straight"
    },
    {
      "id": "index-dense",
      "from": "index",
      "to": "dense",
      "label": "向量",
      "route": "straight",
      "labelDy": -20
    },
    {
      "id": "index-bm25",
      "from": "index",
      "to": "bm25",
      "label": "词表",
      "classification": "统计",
      "variant": "dashed",
      "labelDx": 40
    },
    {
      "id": "dense-rrf",
      "from": "dense",
      "to": "rrf",
      "label": "top-10",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "bm25-rrf",
      "from": "bm25",
      "to": "rrf",
      "label": "top-10",
      "classification": "关键词",
      "variant": "emphasis"
    },
    {
      "id": "rrf-rerank",
      "from": "rrf",
      "to": "rerank",
      "label": "hybrid top-10",
      "labelDy": 24,
      "route": "straight"
    },
    {
      "id": "rerank-gen",
      "from": "rerank",
      "to": "gen",
      "label": "top-3 证据",
      "classification": "证据注入",
      "variant": "emphasis"
    },
    {
      "id": "query-dense",
      "from": "query",
      "to": "dense",
      "label": "q_vec",
      "classification": "查询向量",
      "labelDx": -45
    },
    {
      "id": "query-bm25",
      "from": "query",
      "to": "bm25",
      "label": "query",
      "classification": "关键词",
      "variant": "dashed",
      "labelDx": -45,
      "labelDy": 46
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "为什么混合",
      "items": [
        "dense 抓语义，BM25 抓关键词，两路互补",
        "RRF 只用名次融合（k=60），不比分数口径"
      ]
    },
    {
      "dot": "amber",
      "title": "降级路径",
      "items": [
        "无 GPU / 无模型时 hash_embed → (238, 256)",
        "管线结构不变，只换向量化实现"
      ]
    },
    {
      "dot": "rose",
      "title": "两条时间线",
      "items": [
        "离线：语料 → chunk → 向量矩阵（建索引，不随查询变化）",
        "在线：query 进来 → 双路召回 → 融合重排 → 生成"
      ]
    }
  ]
}